# =====================================================
# Node / TypeScript / Express gitignore
# =====================================================

# Node modules
node_modules/

# Build
dist/
build/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables
.env
.env.local
.env.*.local

# Firebase admin keys
firebase-service-account.json
serviceAccountKey.json
*.serviceAccount.json

# OS-specific files
.DS_Store
Thumbs.db

# IDE configs
.vscode/
.idea/
*.swp
*.swo

# TypeScript cache
*.tsbuildinfo
*.json
# Temporary files
tmp/
temp/
